# ---- required ----
# generate: mix phx.gen.secret   (or: openssl rand -base64 48)
SECRET_KEY_BASE=replace-with-64+-random-chars-replace-with-64+-random-chars-xxxxxxxx
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# ---- database ----
POSTGRES_PASSWORD=callee

# ---- public URL (local defaults) ----
PHX_HOST=localhost
PHX_URL_SCHEME=http
PHX_URL_PORT=4000

# ---- S3 (SeaweedFS locally; any S3 works) ----
AWS_ACCESS_KEY_ID=calleeaccess
AWS_SECRET_ACCESS_KEY=calleesecret
AWS_REGION=us-east-1
S3_BUCKET=callee-recordings
S3_ENDPOINT=http://s3:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333

# ---- TURN (coturn) ----
TURN_SECRET=change-me-turn-secret
# Public IP of the server running coturn (127.0.0.1 is fine for local testing).
TURN_EXTERNAL_IP=127.0.0.1
STUN_URLS=stun:localhost:3478
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp

# ---- Web Push (optional; auto-generated if blank) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- production TLS (docker compose --profile tls up -d) ----
# APP_DOMAIN=call.example.com
# S3_DOMAIN=s3.example.com
# then set: PHX_HOST=call.example.com PHX_URL_SCHEME=https PHX_URL_PORT=443
#           S3_PUBLIC_ENDPOINT=https://s3.example.com
#           TURN_EXTERNAL_IP=<server public ip>
#           STUN_URLS=stun:call.example.com:3478
#           TURN_URLS=turn:call.example.com:3478?transport=udp,turn:call.example.com:3478?transport=tcp

# Allowed websocket origins (prod: //call.example.com)
CHECK_ORIGIN=//localhost,//127.0.0.1

# ---- recording / long calls ----
# server: audio goes through the Phoenix server, which records it (most reliable).
# client: peer-to-peer; the tenant's browser records and uploads 1-minute chunks.
# off:    peer-to-peer, no recording.
RECORDING_MODE=server
MAX_CALL_HOURS=8
MEDIA_PORT_RANGE=50000-50100

# ---- group calls ----
GROUP_MAX=50           # max people in a group call, including the tenant
SPEAKER_SLOTS=4        # loudest speakers each listener receives at once
GROUP_IDLE_MINUTES=10  # end a group call after the host has been alone this long
